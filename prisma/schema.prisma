// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  email              String    @unique
  emailVerified      DateTime?
  passwordHash       String?
  role               Role      @default(CUSTOMER)
  image              String?
  phone              String?
  // Настройки email-уведомлений — заведены с явными дефолтами по смыслу
  // (анонсы выключены по умолчанию, напоминание о корзине включено).
  emailAnnouncements Boolean   @default(false)
  emailBagReminder   Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  cart                 Cart?
  orders               Order[]
  addresses            Address[]
  favorites            Favorite[]
  promoCodeRedemptions PromoCodeRedemption[]
}

// Сохранённые адреса доставки покупателя — используются в личном кабинете
// и подставляются как значение по умолчанию на /checkout.
model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  addressLine String
  city        String
  postalCode  String
  country     String
  phone       String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auth.js (NextAuth) adapter models — needed for OAuth providers (Google/Apple) later.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  // Цена хранится в минимальных единицах валюты (центы и т.п.) вместе с её
  // кодом — товар никогда не привязан к конкретной валюте вроде рубля.
  priceAmount Int
  currency    String   @default("EUR")
  images      String[]
  stock       Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([categoryId])
}

// Избранное — только для вошедших пользователей (в отличие от корзины, без
// гостевой cookie-версии: список желаний осмысленно привязывать к аккаунту).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// Корзина существует и без аккаунта (гостевая, id хранится в cookie) — при
// входе она "усыновляется" пользователем или сливается с уже существующей
// корзиной аккаунта, см. getOrCreateCart() в src/lib/cart.ts.
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  // Хранится просто как строка (код), а не FK на PromoCode — по тому же
  // принципу снапшота, что и OrderItem: даже если промокод потом удалят или
  // изменят в админке, у корзины/заказа не оторвётся ссылка. Актуальность
  // проверяется заново при каждом использовании через validatePromoCode().
  promoCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                    String      @id @default(cuid())
  userId                String
  cartId                String
  status                OrderStatus @default(PENDING)
  // totalAmount уже учитывает скидку (это то, что реально ушло в Stripe);
  // promoCode/discountAmount — снапшот на момент оформления заказа, для
  // истории заказов и чека, не влияет на пересчёт при повторной оплате.
  totalAmount           Int
  currency              String
  promoCode             String?
  discountAmount        Int         @default(0)
  stripePaymentIntentId String?     @unique
  shippingFullName      String
  shippingAddressLine   String
  shippingCity          String
  shippingPostalCode    String
  shippingCountry       String
  shippingPhone         String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
}

// Название и цена товара сохраняются на момент заказа (снапшот) — если товар
// потом изменится или будет удалён, история заказа не должна "переписаться".
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  priceAmount Int
  quantity    Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

// Код хранится в верхнем регистре (нормализуется в src/lib/promo.ts) —
// сравнение всегда регистронезависимое для покупателя.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  type           PromoDiscountType
  // PERCENT — целое число 1–100. FIXED — сумма в минимальных единицах
  // валюты (как priceAmount у Product), привязана к полю currency.
  value          Int
  // Только для FIXED — процентная скидка валюте корзины не принадлежит.
  currency       String?
  isActive       Boolean           @default(true)
  expiresAt      DateTime?
  // Минимальная сумма подытога в минимальных единицах валюты, при которой
  // код применим (null — без ограничения).
  minSubtotal    Int?
  maxRedemptions Int?
  timesRedeemed  Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  redemptions PromoCodeRedemption[]
}

// Промокоды доступны только вошедшим пользователям, и один и тот же код
// каждый пользователь может использовать только один раз — @@unique ниже
// это и обеспечивает на уровне БД, а не только проверкой в коде. Запись
// создаётся вебхуком Stripe только при подтверждённой оплате (не при
// создании заказа), иначе брошенный неоплаченный заказ "сжигал" бы попытку.
model PromoCodeRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  orderId     String
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
}

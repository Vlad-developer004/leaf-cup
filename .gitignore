# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local AI tool skill caches (auto-installed by `prisma init`, not project source)
/.claude/skills/
/skills-lock.json

# internal Claude-session working notes — not meant for the public repo,
# see README.md/docs/DEPLOYMENT.md for the real documentation
/CONTEXT.md
/CLAUDE.md
/AGENTS.md
